// # DNS Capability Allowlist Engine
//
// Logline: Negative-trust capability enforcement against allowed domain patterns.
//
// Setup: Validates candidate query targets against explicit allowlist rules.
//
// Beats:
//   1. Normalize and sanitize candidate domain strings.
//   2. Match domain suffixes, wildcards (*.domain), and exact names.
//   3. Evaluate comma-delimited allowlists with zero ambient bypass.

pub fn has_prefix(str: String, prefix: String) -> Bool {
    let p_len: Int = chars_len(prefix);
    let s_len: Int = chars_len(str);
    if p_len > s_len { return false; }
    return str_slice(str, 0, p_len) == prefix;
}

pub fn has_suffix(str: String, suffix: String) -> Bool {
    let suf_len: Int = chars_len(suffix);
    let s_len: Int = chars_len(str);
    if suf_len > s_len { return false; }
    return str_slice(str, s_len - suf_len, s_len) == suffix;
}

pub fn sanitize_domain(raw: String) -> String {
    let raw_len: Int = chars_len(raw);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < raw_len {
        let ch: String = str_slice(raw, i, i + 1);
        if ch == "A" { out = out + "a"; }
        else if ch == "B" { out = out + "b"; }
        else if ch == "C" { out = out + "c"; }
        else if ch == "D" { out = out + "d"; }
        else if ch == "E" { out = out + "e"; }
        else if ch == "F" { out = out + "f"; }
        else if ch == "G" { out = out + "g"; }
        else if ch == "H" { out = out + "h"; }
        else if ch == "I" { out = out + "i"; }
        else if ch == "J" { out = out + "j"; }
        else if ch == "K" { out = out + "k"; }
        else if ch == "L" { out = out + "l"; }
        else if ch == "M" { out = out + "m"; }
        else if ch == "N" { out = out + "n"; }
        else if ch == "O" { out = out + "o"; }
        else if ch == "P" { out = out + "p"; }
        else if ch == "Q" { out = out + "q"; }
        else if ch == "R" { out = out + "r"; }
        else if ch == "S" { out = out + "s"; }
        else if ch == "T" { out = out + "t"; }
        else if ch == "U" { out = out + "u"; }
        else if ch == "V" { out = out + "v"; }
        else if ch == "W" { out = out + "w"; }
        else if ch == "X" { out = out + "x"; }
        else if ch == "Y" { out = out + "y"; }
        else if ch == "Z" { out = out + "z"; }
        else { out = out + ch; }
        i = i + 1;
    }
    // Trim trailing dot if present
    let out_len: Int = chars_len(out);
    if out_len > 1 && has_suffix(out, ".") {
        return str_slice(out, 0, out_len - 1);
    }
    return out;
}

pub fn domain_matches_pattern(domain: String, pattern: String) -> Bool {
    let clean_dom: String = sanitize_domain(domain);
    let clean_pat: String = sanitize_domain(pattern);

    if clean_pat == "*" || clean_pat == clean_dom {
        return true;
    }
    if has_prefix(clean_pat, "*.") {
        let suffix: String = str_slice(clean_pat, 1, chars_len(clean_pat));
        if has_suffix(clean_dom, suffix) {
            return true;
        }
        let bare: String = str_slice(clean_pat, 2, chars_len(clean_pat));
        if clean_dom == bare {
            return true;
        }
    }
    return false;
}

pub fn check_domain_allowed(domain: String, allowlist_csv: String) -> Bool {
    if chars_len(allowlist_csv) == 0 {
        return true;
    }
    let csv_len: Int = chars_len(allowlist_csv);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= csv_len {
        if i == csv_len || str_slice(allowlist_csv, i, i + 1) == "," {
            if i > start {
                let pat: String = str_slice(allowlist_csv, start, i);
                if domain_matches_pattern(domain, pat) {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}
